+/* ================= 宇航员步行控制 ================= */
+function stepAstroWalk(dt) {
+  var acc = (keys.w ? 1 : 0) - (keys.s ? 1 : 0);
+  var turn = (keys.a ? 1 : 0) - (keys.d ? 1 : 0);
+  /* 速度：步行加速/减速（月球 1/6 重力，步幅轻快） */
+  if (acc > 0) {
+    astroS.spd += 3.0 * dt;
+  } else if (acc < 0) {
+    astroS.spd -= 2.4 * dt;
+  } else {
+    astroS.spd -= astroS.spd * 5.0 * dt;
+  }
+  astroS.spd = clamp(astroS.spd, -1.4, 2.2);
+  var moving = Math.abs(astroS.spd) > 0.08;
+  /* 转向：走路时也能转向（原地转向略慢） */
+  if (turn) {
+    astroS.head += turn * (moving ? 2.4 : 1.5) * dt * (astroS.spd >= 0 ? 1 : -1);
+  }
+  /* 位置（宇航员模型默认面朝 +z，rotation.y=head 时前向 = (sin h, cos h)） */
+  astroS.x += Math.sin(astroS.head) * astroS.spd * dt;
+  astroS.z += Math.cos(astroS.head) * astroS.spd * dt;
+  astro.position.set(astroS.x, 0, astroS.z);
+  astro.rotation.y = astroS.head;
+  /* 走路动画：相位随速度推进，腿/手摆动 + 低重力轻弹 */
+  astroS.phase += Math.abs(astroS.spd) * dt * 7.0;
+  var ph = astroS.phase;
+  var mv = moving ? 1 : 0;
+  var L = astro.userData.limbs;
+  if (L) {
+    L.thighs.forEach(function (m, i) {
+      var sw = Math.sin(ph + i * Math.PI);
+      m.position.z = sw * 0.16 * mv;
+      m.rotation.x = sw * 0.40 * mv;
+    });
+    L.shins.forEach(function (m, i) {
+      var sw = Math.sin(ph + i * Math.PI + 0.5);
+      m.position.z = sw * 0.13 * mv;
+      m.rotation.x = sw * 0.34 * mv;
+    });
+    L.arms.forEach(function (m, i) {
+      var sw = Math.sin(ph + i * Math.PI + Math.PI);
+      m.position.z = sw * 0.11 * mv;
+      m.rotation.x = sw * 0.32 * mv;
+    });
+    L.gloves.forEach(function (m, i) {
+      if (i < 2) m.position.z = Math.sin(ph + i * Math.PI + Math.PI) * 0.12 * mv;
+    });
+  }
+  astro.position.y = Math.abs(Math.sin(ph * 0.5)) * 0.07 * mv;
+  astro.rotation.z = Math.sin(ph) * 0.025 * mv;
+  /* 摄像机：宇航员后上方第三人称，平滑跟随 */
+  var d = 7.5 * vk() * (state.cam === 'near' ? 0.6 : 1);
+  var camX = astroS.x - Math.sin(astroS.head) * d;
+  var camZ = astroS.z - Math.cos(astroS.head) * d;
+  aimSmooth(camX, 2.0 + d * 0.30, camZ, astroS.x, 1.5, astroS.z, 0.16);
